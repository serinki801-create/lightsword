export TARGET = iphone:clang:latest:16.0
export ARCHS = arm64
export SWIFT_OPTFLAG = -Onone -num-threads 1

$(info [DEBUG] user Makefile: ARCHS=$(ARCHS))

include $(THEOS)/makefiles/common.mk

$(info [DEBUG] after theos common: ARCHS=$(ARCHS) TARGET_ARCHS=$(TARGET_ARCHS))

APPLICATION_NAME = srk801
srk801_FILES = $(wildcard *.m) $(wildcard *.c)
srk801_SWIFT_FILES = $(wildcard *.swift)
srk801_FRAMEWORKS = UIKit Foundation CoreGraphics IOKit
srk801_CFLAGS = -fobjc-arc -Wno-deprecated-declarations
srk801_SWIFTFLAGS = -import-objc-header $(PWD)/Bridging-Header.h
srk801_INSTALL_TARGET_PROCESSES = srk801
srk801_CODESIGN_FLAGS = -S
srk801_RESOURCE_FILES = Info.plist

include $(THEOS_MAKE_PATH)/application.mk
